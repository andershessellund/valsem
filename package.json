{
  "name": "valsem",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "author": "Anders Hessellund Jensen",
  "description": "Value semantics for JavaScript — structural equality, hashing, interning, and value collections.",
  "keywords": [
    "value semantics",
    "structural equality",
    "deep equal",
    "hashing",
    "interning",
    "immutable",
    "persistent data structures"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andershessellund/valsem.git"
  },
  "bugs": "https://github.com/andershessellund/valsem/issues",
  "homepage": "https://github.com/andershessellund/valsem#readme",
  "sideEffects": [
    "./dist/temporal.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "default": "./dist/temporal.js"
    },
    "./binding": {
      "types": "./dist/binding.d.ts",
      "default": "./dist/binding.js"
    },
    "./draft": {
      "types": "./dist/draft.d.ts",
      "default": "./dist/draft.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-helpers.ts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run",
    "bench": "pnpm build && pnpm bench:node && pnpm bench:bun && pnpm bench:spidermonkey && pnpm bench:report",
    "bench:node": "node --expose-gc bench/run.mjs",
    "bench:bun": "node bench/run-bun.mjs",
    "bench:spidermonkey": "node bench/run-spidermonkey.mjs",
    "bench:report": "node bench/report.mjs",
    "bench:pool": "node --expose-gc scripts/experiments/pool-gc-bench.mjs",
    "bench:soak": "pnpm build && node scripts/experiments/soak.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.tests.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@conventional-commits/parser": "0.4.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "fast-check": "^4.9.0",
    "fast-deep-equal": "^3.1.3",
    "immer": "^11.1.18",
    "immutable": "^5.1.9",
    "mutative": "^1.3.0",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1"
  }
}
