{
  "name": "valsem",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": "Anders Hessellund Jensen",
  "description": "Value semantics for JavaScript — structural equality, hashing, interning, and value collections.",
  "keywords": [
    "value semantics",
    "structural equality",
    "deep equal",
    "hashing",
    "interning",
    "immutable",
    "persistent data structures"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "default": "./dist/temporal.js"
    },
    "./binding": {
      "types": "./dist/binding.d.ts",
      "default": "./dist/binding.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "packageManager": "pnpm@10.32.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
